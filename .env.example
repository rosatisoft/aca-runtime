# Required for loading ACA Atlas artifacts.
ACA_ARTIFACTS_PATH=C:\path\to\ACA\artifacts

# Required by the current embedding layer unless replaced by another embedder.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: used only by the Ollama quickstart.
OLLAMA_HOST=http://localhost:11434
ACA_OLLAMA_MODEL=phi4-mini
